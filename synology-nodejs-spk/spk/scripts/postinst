#!/bin/sh
# Node.js SPK - post-install: expose the runtime on PATH and into the layout
# that Synology's dependent packages expect.
. "$(dirname "$0")/common"

# The official package kept /usr/local/lib/node_modules as a symlink; drop it so
# it cannot shadow anything.
[ -L /usr/local/lib/node_modules ] && rm -f /usr/local/lib/node_modules

DO_LINK

# Sanity report into the installer log.
"${PKG_DIR}/usr/local/bin/node" --version 2>&1 || true
exit 0